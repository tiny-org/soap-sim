; Sodium oleate anion (C18:1, cis-9) - MARTINI 2 coarse-grained topology
; 5 beads: Qa (carboxylate head) + C1 (saturated) + C3 (unsaturated, double bond) + C1 + C1

[moleculetype]
; molname  nrexcl
  OLE      1

[atoms]
; nr  type  resnr  residu  atom  cgnr  charge  mass
  1   Qa    1      OLE     COO   1     -1.0    72.0
  2   C1    1      OLE     C1A   2      0.0    72.0
  3   C3    1      OLE     C3A   3      0.0    72.0
  4   C1    1      OLE     C1B   4      0.0    72.0
  5   C1    1      OLE     C1C   5      0.0    72.0

[bonds]
; i  j  funct  length  force.c.
  1  2  1      0.47    1250
  2  3  1      0.47    1250
  3  4  1      0.47    1250
  4  5  1      0.47    1250

[angles]
; i  j  k  funct  angle  force.c.
  1  2  3  2      180.0  25.0
  2  3  4  2      120.0  45.0
  3  4  5  2      180.0  25.0
